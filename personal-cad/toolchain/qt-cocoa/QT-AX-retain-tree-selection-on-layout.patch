+void QAccessibleTree::modelChange(QAccessibleTableModelChangeEvent *event)
+{
+    if (event->modelChangeType() != QAccessibleTableModelChangeEvent::ModelReset) {
+        QAccessibleTable::modelChange(event);
+        return;
+    }
+
+    // QTreeView reports ModelReset after laying out the view, even though the
+    // underlying model and its persistent indexes may still be valid.
+    ChildCache retained;
+    QList<QAccessible::Id> retired;
+    for (QAccessible::Id id : std::as_const(childToId)) {
+        auto *iface = QAccessible::accessibleInterface(id);
+        const int childIndex = iface && iface->isValid() ? indexOfChild(iface) : -1;
+        if (childIndex >= 0 && !retained.contains(childIndex)
+            && (iface->role() != QAccessible::ColumnHeader || childIndex < columnCount())) {
+            retained.insert(childIndex, id);
+        } else {
+            retired.append(id);
+        }
+    }
+    childToId = std::move(retained);
+    for (QAccessible::Id id : retired)
+        QAccessible::deleteAccessibleInterface(id);
+}
