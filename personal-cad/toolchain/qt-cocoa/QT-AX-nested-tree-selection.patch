+QList<QAccessibleInterface *> QAccessibleTree::selectedCells() const
+{
+    const auto *treeView = qobject_cast<const QTreeView *>(view());
+    if (!treeView || !treeView->selectionModel())
+        return {};
+
+    const QModelIndexList selectedIndexes = treeView->selectionModel()->selectedIndexes();
+    QList<QAccessibleInterface *> cells;
+    cells.reserve(selectedIndexes.size());
+    for (const QModelIndex &index : selectedIndexes) {
+        // Model rows are parent-relative. Accessible children use visual tree order.
+        const int childIndex = treeView->d_func()->accessibleChildIndex(index);
+        if (auto *iface = child(childIndex))
+            cells.append(iface);
+    }
+    return cells;
+}
